# ============================================================
# 环境配置模板
# 复制为 dev.env / test.env / prod.env 后按需修改。
# 敏感值请勿提交真实凭证；本地可用占位值。
# 注意：.env 文件使用 KEY=VALUE，值不要加引号，不要有尾随空格。
# ============================================================

# 服务端口
SERVER_PORT=8080

# 数据库连接
DB_URL=jdbc:mysql://localhost:3306/demo?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=your_db_password

# Redis 连接
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DATABASE=0

# 阿里云 OSS
ALIYUN_OSS_ENDPOINT=your_oss_endpoint
ALIYUN_OSS_ACCESS_KEY_ID=your_access_key_id
ALIYUN_OSS_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_OSS_BUCKET_NAME=your_bucket_name

# JWT 签名密钥：Base64 编码的随机字节，解码后S至少 64 字节（HS512 要求 512 bit）
# 每个环境单独生成，不要复用；生成命令：openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_BASE64_OF_64_RANDOM_BYTES

# JWT 过期时间（毫秒），1800000 = 30 分钟
JWT_EXPIRE=1800000