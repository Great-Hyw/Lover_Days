# ============================================================
# 环境变量模板（本文件会提交到 git，只放示例值，不要填真实口令）
#
# 用法：
#   1. 复制一份并改名，例如 dev.env / test.env / prod.env
#      （这几个文件已被 .gitignore 忽略，不会提交、也不会打包进 jar）
#   2. 填入你自己环境的真实值
#   3. 运行时 Spring Boot 会加载 env/${spring.profiles.active:dev}.env
#      相对路径以「启动时的工作目录」为准，所以请在 demo/ 目录下启动
#
# 生产环境也可以不要这个文件，直接用系统环境变量注入同名变量
# （系统环境变量优先级高于 env 文件）：
#   DB_IP=10.0.0.5
#   SPRING_DATASOURCE_USERNAME=app_user
#   SPRING_DATASOURCE_PASSWORD=********
#   JWT_SECRET=********
#   CF_SITEKEY=********
#   然后 java -jar demo-0.0.1-SNAPSHOT.jar --spring.profiles.active=prod
# ============================================================

# 数据库
DB_IP=127.0.0.1
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=your_db_password

# JWT 签名密钥（建议每个环境不同；线上务必用足够长的随机串）
JWT_SECRET=please_change_me_to_a_long_random_secret

# Cloudflare Turnstile site key
CF_SITEKEY=your_turnstile_site_key