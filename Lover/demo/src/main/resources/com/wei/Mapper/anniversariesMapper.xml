<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wei.Mapper.anniversariesMapper">

    <update id="update">
        update user.anneriversaries
        <set>
            <if test="userId!=null">
                user_id=#{userId},
            </if>
            <if test="title!=null">
                title=#{title},
            </if>
            <if test="date!=null">
                date=#{date},
            </if>
            <if test="type!=null">
                type=#{type},
            </if>
            <if test="icon!=null">
                icon=#{icon},
            </if>
            <if test="color!=null">
                color=#{color},
            </if>
            <if test="isYearly!=null">
                is_yearly=#{isYearly},
            </if>
            <if test="note!=null">
                note=#{note},
            </if>
            <if test="bgImage!=null">
                bg_image=#{bgImage},
            </if>
            <if test="updatedAt!=null">
                updated_at=#{updatedAt}
            </if> </set>
            <where>
                id=#{id}
            </where>


    </update>
</mapper>