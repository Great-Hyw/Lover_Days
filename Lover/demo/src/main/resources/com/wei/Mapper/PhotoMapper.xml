<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wei.Mapper.PhotoMapper">

    <select id="selectAll" resultType="com.wei.pojo.Photo">
        select _key, url, name, size, created_at, id from user.photo
        <where>
            user_id = #{userId}
            <if test="lastId!=null">
               and id &lt; #{lastId}
            </if>
        </where>
        order by id desc limit 3;
    </select>
</mapper>